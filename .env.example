# ==============================================================================
# GROWTH+ SIGNAL INTELLIGENCE PLATFORM CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and modify values for your target deployment.
# Variables defined here override defaults provided in the codebase.
# Strict validation is applied on application startup (fail-fast).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Environment profile: 'development', 'testing', 'staging', 'production'
GROWTH_ENV=development

# Enable debug logging and verbose diagnostic endpoints
GROWTH_DEBUG=false

# Network interface host binding for the FastAPI server
GROWTH_HOST=0.0.0.0

# HTTP port binding for the FastAPI server
GROWTH_PORT=8000

# Global API URL prefix for V1 endpoints
GROWTH_API_V1_PREFIX=/v1

# Allow in-memory fallback adapters (FORBIDDEN in production)
GROWTH_ALLOW_EPHEMERAL_ADAPTERS=true

# Relative or absolute path to baseline policy defaults YAML
GROWTH_CONFIG_PATH=config/defaults.yaml

# Enable token-bucket IP rate limiter
GROWTH_RATE_LIMIT_ENABLED=true

# Maximum tokens per client bucket (burst capacity)
GROWTH_RATE_LIMIT_CAPACITY=120

# Token refill rate per second
GROWTH_RATE_LIMIT_REFILL_RATE=2.0

# Maximum number of unique IP buckets to track simultaneously in memory
GROWTH_RATE_LIMIT_MAX_CLIENTS=4096

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# Async SQLAlchemy database DSN for API runtime (asyncpg)
# Required when GROWTH_ALLOW_EPHEMERAL_ADAPTERS=false
GROWTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/growth_plus

# Sync database DSN used for Alembic migrations and table provisioning (psycopg)
GROWTH_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/growth_plus

# Optional isolated PostgreSQL test DSN for integration tests
GROWTH_TEST_MIGRATION_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/growth_plus_test

# Connection pool size and overflow limits
GROWTH_DATABASE_POOL_SIZE=10
GROWTH_DATABASE_MAX_OVERFLOW=20
GROWTH_DATABASE_POOL_TIMEOUT=30.0
GROWTH_DATABASE_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. MESSAGING & EVENT STREAMING (NATS JETSTREAM)
# ------------------------------------------------------------------------------
# JSON-encoded array of NATS cluster server URLs
GROWTH_NATS_SERVERS=["nats://localhost:4222"]

# Canonical JetStream stream name for platform event envelopes
GROWTH_NATS_STREAM_NAME=GROWTH_EVENTS

# Maximum message payload size in bytes (256 KiB default)
GROWTH_NATS_MAX_MSG_SIZE=262144

# JetStream consumer acknowledgment timeout in seconds
GROWTH_NATS_ACK_WAIT_SECONDS=30

# Maximum delivery attempts before redelivery dead-lettering
GROWTH_NATS_MAX_DELIVER=5

# ------------------------------------------------------------------------------
# 4. REDIS & CACHING (OPTIONAL)
# ------------------------------------------------------------------------------
# Redis connection URL for distributed caching and state
GROWTH_REDIS_URL=redis://localhost:6379/0

# Default cache entry TTL in seconds
GROWTH_CACHE_DEFAULT_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 5. SECURITY, AUTHENTICATION & CORS
# ------------------------------------------------------------------------------
# JSON-encoded list of allowed browser origins (strict HTTPS, no wildcards in production)
GROWTH_CORS_ORIGINS_JSON=["https://growthplus.ai"]

# JSON-encoded list of trusted reverse proxy CIDRs for X-Forwarded-For parsing
GROWTH_TRUSTED_PROXY_CIDRS_JSON=[]

# Secret key for JWT token signing (minimum 32 characters in production)
GROWTH_JWT_SECRET=insecure-development-jwt-secret-replace-in-production-min-32-chars

# HMAC-SHA256 secret key for signing and verifying ML ModelBundles
GROWTH_MODEL_VERIFICATION_SECRET_KEY=insecure-model-verification-secret-32-chars-min

# HMAC-SHA256 secret key for signing outbound customer webhook deliveries
GROWTH_WEBHOOK_SIGNING_SECRET=insecure-webhook-signing-secret-key-for-hmac-sha256

# ------------------------------------------------------------------------------
# 6. EXTERNAL DATA PROVIDERS & INGESTION
# ------------------------------------------------------------------------------
# GDELT Project Doc 2.0 API endpoint
GROWTH_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GROWTH_GDELT_REQUEST_TIMEOUT_SECONDS=10.0
GROWTH_GDELT_CONNECT_TIMEOUT_SECONDS=3.0

# Mandatory crawler contact user-agent header
GROWTH_GDELT_CONTACT_USER_AGENT=growthplus-bot/1.0 (+https://growthplus.ai/bot)

# Bureau of Labor Statistics (BLS) public API endpoint
GROWTH_BLS_ENDPOINT=https://api.bls.gov/publicAPI/v2/timeseries/data/
GROWTH_BLS_API_KEY=

# Federal Reserve H.15 interest rate series index
GROWTH_FED_BOARD_URL=https://www.federalreserve.gov/releases/h15/

# Outbound webhook delivery constraints (SSRF-hardened HTTPS port 443 only)
GROWTH_WEBHOOK_CONNECT_TIMEOUT_SECONDS=3.0
GROWTH_WEBHOOK_READ_TIMEOUT_SECONDS=10.0
GROWTH_WEBHOOK_MAX_PAYLOAD_BYTES=262144
GROWTH_WEBHOOK_MAX_RESPONSE_BYTES=65536
GROWTH_WEBHOOK_MAX_REDIRECTS=4

# ------------------------------------------------------------------------------
# 7. ML MODELING, INFERENCE & SIGNALS
# ------------------------------------------------------------------------------
# Primary operational trading horizon: swing_24h | position_7d
GROWTH_DEFAULT_HORIZON=swing_24h

# Base execution cost hurdle log return (5 bps)
GROWTH_BASE_COST_HURDLE=0.0005

# Horizon-specific return hurdle floors
GROWTH_HORIZON_FLOOR_SWING=0.003
GROWTH_HORIZON_FLOOR_POSITION=0.012

# Holdout Expected Calibration Error (ECE) admission gate threshold
GROWTH_ECE_GATE_THRESHOLD=0.08

# ModelBundle cryptographic validity duration in days
GROWTH_BUNDLE_TTL_DAYS=30

# Minimum conviction confidence for notification dispatch
GROWTH_NOTIFICATION_MIN_CONFIDENCE=0.60

# Anti-spam alert notification cooldown period per market/horizon in seconds
GROWTH_NOTIFICATION_COOLDOWN_SECONDS=900.0

# ------------------------------------------------------------------------------
# 8. RESILIENCE & CIRCUIT BREAKERS
# ------------------------------------------------------------------------------
# Consecutive provider failures required to trip circuit breaker open
GROWTH_CIRCUIT_FAILURE_THRESHOLD=5

# Recovery cooling period in seconds before admitting a half-open probe (60s - 900s)
GROWTH_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=60.0

# Maximum execution time in seconds allowed for a half-open probe
GROWTH_CIRCUIT_PROBE_TIMEOUT_SECONDS=30.0
